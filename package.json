{
  "name": "tectonas-ui",
  "version": "2.0.0",
  "description": "Framework-independent Tectonas UI web components built with Lit",
  "type": "module",
  "main": "./dist/tectonas-ui.js",
  "module": "./dist/tectonas-ui.js",
  "types": "./dist/index.d.ts",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tectonas-ui.js"
    },
    "./performance-summary": {
      "types": "./dist/components/performance-summary/index.d.ts",
      "import": "./dist/performance-summary.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/tectonas-ui.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "performance-summary": [
        "dist/components/performance-summary/index.d.ts"
      ],
      "register": [
        "dist/register.d.ts"
      ],
      "*": [
        "dist/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && npm run typecheck && vite build && tsc --emitDeclarationOnly",
    "dev": "vite build --watch",
    "prepare": "npm run build"
  },
  "keywords": [
    "lit",
    "web-components",
    "custom-elements",
    "angular",
    "react"
  ],
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
